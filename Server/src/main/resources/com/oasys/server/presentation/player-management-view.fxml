<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<GridPane hgap="10" vgap="10" xmlns:fx="http://javafx.com/fxml" fx:controller="com.oasys.server.presentation.PlayerManagementController">
    <!-- Left ListView for available players -->
    <ListView fx:id="availablePlayersListView" GridPane.columnIndex="0" />

    <!-- Center buttons for adding/removing players -->
    <VBox alignment="CENTER" spacing="10" GridPane.columnIndex="1">
        <Button text="Randomized Players" onAction="#randomizePlayers"/>
        <Button text="Add >>" onAction="#addPlayerToGame" />
        <!--<Button text="<< Remove" onAction="#removePlayerFromGame" />-->
        <Button text="&lt;&lt; Remove" onAction="#removePlayerFromGame" />
    </VBox>



    <!-- Right ListView for players added to the game -->
    <ListView fx:id="addedPlayersListView" GridPane.columnIndex="2" />
</GridPane>
